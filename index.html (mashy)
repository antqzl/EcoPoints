<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EcoPoints</title>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ========================================== -->
  <!-- PAGE 1: LOGIN SECTION (Active by default)  -->
  <!-- ========================================== -->
  <section id="loginPage" class="page-view active">
    <div class="login-container">
      
      <!-- LEFT SIDE: Hero Section -->
      <main class="hero-section">
        <div class="brand">
          <div class="logo-icon">
            <i data-lucide="leaf"></i>
          </div>
          <span class="brand-name">EcoPoints</span>
        </div>

        <div class="hero-content">
          <h1 class="hero-title">
            People.<br>
            Progress.<br>
            <span class="highlight">A Greener Tomorrow.</span>
          </h1>
          <p class="hero-subtitle">
            Join a community of students and employees making a real difference through sustainable choices, everyday.
          </p>

          <div class="features-grid">
            <div class="feature-item">
              <div class="feature-icon icon-green">
                <i data-lucide="leaf"></i>
              </div>
              <div class="feature-text">
                <h4>Take action</h4>
                <p>Sustainable transport, energy saving and more.</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon icon-teal">
                <i data-lucide="users"></i>
              </div>
              <div class="feature-text">
                <h4>Earn rewards</h4>
                <p>Get EcoPoints for positive choices.</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon icon-emerald">
                <i data-lucide="trending-up"></i>
              </div>
              <div class="feature-text">
                <h4>Create impact</h4>
                <p>Greener campuses and healthier communities.</p>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- RIGHT SIDE: Login Card Area -->
      <aside class="auth-section">
        <div class="login-card">
          <div class="card-brand">
            <div class="logo-icon small">
              <i data-lucide="leaf"></i>
            </div>
            <span class="brand-name">EcoPoints</span>
          </div>

          <h2 class="card-title">
            Welcome back — <br>
            <span class="green-text">continue your sustainability journey.</span>
          </h2>
          <p class="card-subtitle">
            Sign in to track your activity, earn rewards, and make a bigger impact together.
          </p>

          <form id="loginForm" class="login-form">
            <div class="form-group">
              <label for="email">Email</label>
              <div class="input-wrapper">
                <i data-lucide="mail" class="input-icon"></i>
                <input type="email" id="email" placeholder="name@university.edu" required>
              </div>
            </div>

            <div class="form-group">
              <label for="password">Password</label>
              <div class="input-wrapper">
                <i data-lucide="lock" class="input-icon"></i>
                <input type="password" id="password" placeholder="Enter your password" required>
                <button type="button" id="togglePassword" class="toggle-password" aria-label="Toggle password visibility">
                  <i data-lucide="eye"></i>
                </button>
              </div>
            </div>

            <div class="form-options">
              <label class="checkbox-label">
                <input type="checkbox" id="rememberMe">
                <span class="custom-checkbox"></span>
                Remember me
              </label>
              <a href="#" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="btn-primary">
              Sign In <i data-lucide="arrow-right"></i>
            </button>
          </form>

          <div class="divider">
            <span>or</span>
          </div>

          <button class="btn-sso" id="googleSignInBtn">
            <svg class="google-icon" width="18" height="18" viewBox="0 0 18 18">
              <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
              <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
              <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
            </svg>
            Sign in with Google
          </button>

          <p class="demo-link">
            New to EcoPoints? <a href="#">Request Demo Access <i data-lucide="arrow-right"></i></a>
          </p>
        </div>
      </aside>
    </div>
  </section>


  <!-- ========================================== -->
  <!-- PAGE 2: HOME DASHBOARD (Hidden initially)  -->
  <!-- ========================================== -->
  <section id="homePage" class="page-view">
    <div class="app-container">
      
      <!-- LEFT SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-top">
          <div class="brand">
            <div class="logo-icon">
              <i data-lucide="leaf"></i>
            </div>
            <span class="brand-name">EcoPoints</span>
          </div>

          <nav class="nav-menu">
            <a href="#" class="nav-item active nav-home-btn">
              <i data-lucide="home"></i>
              <span>Home</span>
            </a>
            <a href="#" class="nav-item nav-dash-btn">
              <i data-lucide="bar-chart-2"></i>
              <span>Dashboard</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="zap"></i>
              <span>EcoPoints</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="gift"></i>
              <span>Rewards</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="user"></i>
              <span>Profile</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="settings"></i>
              <span>Admin</span>
            </a>
          </nav>
        </div>

        <div class="sidebar-bottom">
          <div class="slogan-card">
            <div class="globe-icon">
              <i data-lucide="globe"></i>
            </div>
            <h4>Small actions brighter tomorrows.</h4>
            <p>People. Progress. A Greener Tomorrow.</p>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT AREA -->
      <main class="main-content">
        
        <!-- TOP HEADER -->
        <header class="top-header">
          <div class="search-bar">
            <i data-lucide="search"></i>
            <input type="text" placeholder="Search for initiatives, rewards, or people...">
          </div>

          <div class="header-right">
            <button class="notification-btn" aria-label="Notifications">
              <i data-lucide="bell"></i>
              <span class="notification-badge"></span>
            </button>

            <div class="user-profile">
              <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=120" alt="Sarah Tan" class="avatar">
              <div class="user-info">
                <span class="user-name">Sarah Tan</span>
                <span class="user-role">Student</span>
              </div>
              <i data-lucide="chevron-down" class="dropdown-icon"></i>
            </div>
          </div>
        </header>

        <!-- DASHBOARD BODY -->
        <div class="dashboard-body">
          
          <!-- HERO BANNER -->
          <section class="welcome-banner">
            <div class="banner-text">
              <span class="banner-tag">
                <i data-lucide="leaf"></i> WELCOME TO ECOPOINTS
              </span>
              <h1>Track sustainability.<br>Earn rewards.</h1>
              <p>Students and employees can earn EcoPoints through sustainable transport, energy saving, volunteering and more — for a cleaner, healthier tomorrow.</p>
              <button class="btn-banner">
                Start Collecting Points <i data-lucide="arrow-right"></i>
              </button>
            </div>
            <div class="banner-graphic">
              <div class="graphic-badge">
                <span>GREENER PEOPLE BRIGHTER TOMORROWS</span>
              </div>
            </div>
          </section>

          <!-- STATS CARDS ROW -->
          <section class="stats-grid">
            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-green">
                  <i data-lucide="leaf"></i>
                </div>
                <i data-lucide="chevron-right" class="arrow-link"></i>
              </div>
              <span class="stat-label">Your EcoPoints Balance</span>
              <div class="stat-value-group">
                <span class="stat-value">1,250</span>
                <span class="stat-pill pill-green"><i data-lucide="arrow-up-right"></i> +120</span>
              </div>
              <p class="stat-subtext">Keep going! Every action counts.</p>
            </div>

            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-blue">
                  <i data-lucide="zap"></i>
                </div>
                <i data-lucide="chevron-right" class="arrow-link"></i>
              </div>
              <span class="stat-label">Latest Activities</span>
              <div class="stat-value-group">
                <span class="stat-value">5</span>
                <span class="stat-tag-text">this week</span>
              </div>
              <p class="stat-subtext">Cycling, volunteering, energy saving</p>
            </div>

            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-orange">
                  <i data-lucide="gift"></i>
                </div>
                <i data-lucide="chevron-right" class="arrow-link"></i>
              </div>
              <span class="stat-label">Rewards Redeemed</span>
              <div class="stat-value-group">
                <span class="stat-value">3</span>
                <span class="stat-tag-text">this semester</span>
              </div>
              <p class="stat-subtext">You're making a positive impact!</p>
            </div>

            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-emerald">
                  <i data-lucide="trophy"></i>
                </div>
                <i data-lucide="chevron-right" class="arrow-link"></i>
              </div>
              <span class="stat-label">Your Energy-Saving Rank</span>
              <div class="stat-value-group">
                <span class="stat-value">#12</span>
                <span class="stat-pill pill-green"><i data-lucide="arrow-up-right"></i> 5 places</span>
              </div>
              <p class="stat-subtext">Top 10% in your organisation!</p>
            </div>
          </section>

          <!-- MAIN 3-COLUMN SECTIONS -->
          <section class="content-grid">
            <div class="card-box initiatives-card">
              <div class="card-title-bar">
                <h3>Featured Initiatives</h3>
                <a href="#" class="view-link">View All <i data-lucide="arrow-right"></i></a>
              </div>
              <div class="initiatives-list">
                <div class="initiative-item">
                  <div class="init-thumb bg-transport"></div>
                  <div class="init-details">
                    <h4>Sustainable Transport Week</h4>
                    <span class="init-date"><i data-lucide="calendar"></i> Apr 22 – Apr 28</span>
                    <p>Cycle, walk or take public transport to earn extra EcoPoints!</p>
                  </div>
                  <span class="points-badge">+50 pts</span>
                </div>

                <div class="initiative-item">
                  <div class="init-thumb bg-greenup"></div>
                  <div class="init-details">
                    <h4>Campus Green-Up</h4>
                    <span class="init-date"><i data-lucide="calendar"></i> Ongoing</span>
                    <p>Join tree planting and campus clean-up activities.</p>
                  </div>
                  <span class="points-badge">+100 pts</span>
                </div>

                <div class="initiative-item">
                  <div class="init-thumb bg-energy"></div>
                  <div class="init-details">
                    <h4>Energy Saving Challenge</h4>
                    <span class="init-date"><i data-lucide="calendar"></i> Apr 1 – Apr 30</span>
                    <p>Reduce energy usage and help your campus reach net zero.</p>
                  </div>
                  <span class="points-badge">+75 pts</span>
                </div>
              </div>
            </div>

            <div class="card-box energy-preview-card">
              <div class="card-title-bar">
                <h3>Energy Dashboard Preview</h3>
                <a href="#" class="view-link nav-dash-btn">View Dashboard <i data-lucide="arrow-right"></i></a>
              </div>

              <div class="energy-metrics">
                <span class="metric-label">Campus Energy Usage</span>
                <div class="metric-value-row">
                  <span class="metric-number">12,540 kWh</span>
                  <span class="stat-pill pill-green"><i data-lucide="arrow-down-right"></i> 8%</span>
                  <span class="metric-sub">vs. last month</span>
                </div>
              </div>

              <div class="bar-chart-container">
                <div class="y-axis">
                  <span>20K</span>
                  <span>15K</span>
                  <span>10K</span>
                  <span>5K</span>
                  <span>0</span>
                </div>
                <div class="bars-wrapper">
                  <div class="bar-item"><div class="bar-fill" style="height: 65%;"></div><span>Jan</span></div>
                  <div class="bar-item"><div class="bar-fill" style="height: 70%;"></div><span>Feb</span></div>
                  <div class="bar-item"><div class="bar-fill" style="height: 55%;"></div><span>Mar</span></div>
                  <div class="bar-item"><div class="bar-fill" style="height: 50%;"></div><span>Apr</span></div>
                  <div class="bar-item"><div class="bar-fill" style="height: 48%;"></div><span>May</span></div>
                  <div class="bar-item"><div class="bar-fill highlight-bar" style="height: 42%;"></div><span>Jun</span></div>
                </div>
              </div>

              <div class="energy-footer-note">
                <div class="note-icon"><i data-lucide="leaf"></i></div>
                <div class="note-text">
                  <strong>Great progress!</strong>
                  <p>Energy usage is 8% lower than last month.</p>
                </div>
              </div>
            </div>

            <div class="card-box impact-card">
              <h3>Make a Bigger Impact</h3>
              <div class="impact-illustration">
                <div class="globe-graphic">
                  <i data-lucide="globe"></i>
                </div>
              </div>
              <p class="impact-desc">Together, our sustainable choices create healthier campuses, stronger communities and a brighter future.</p>
              
              <button class="btn-explore">
                Explore Initiatives <i data-lucide="arrow-right"></i>
              </button>

              <div class="impact-badges">
                <div class="badge-item">
                  <i data-lucide="leaf"></i>
                  <span>Cleaner Campus</span>
                </div>
                <div class="badge-item">
                  <i data-lucide="users"></i>
                  <span>Stronger Communities</span>
                </div>
                <div class="badge-item">
                  <i data-lucide="sun"></i>
                  <span>A Greener Tomorrow</span>
                </div>
              </div>
            </div>
          </section>

        </div>
      </main>
    </div>
  </section>


  <!-- ========================================== -->
  <!-- PAGE 3: DASHBOARD VIEW (Hidden initially)  -->
  <!-- ========================================== -->
  <section id="dashboardPage" class="page-view">
    <div class="app-container">
      
      <!-- LEFT SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-top">
          <div class="brand">
            <div class="logo-icon">
              <i data-lucide="leaf"></i>
            </div>
            <span class="brand-name">EcoPoints</span>
          </div>

          <nav class="nav-menu">
            <a href="#" class="nav-item nav-home-btn">
              <i data-lucide="home"></i>
              <span>Home</span>
            </a>
            <a href="#" class="nav-item active nav-dash-btn">
              <i data-lucide="bar-chart-2"></i>
              <span>Dashboard</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="zap"></i>
              <span>EcoPoints</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="gift"></i>
              <span>Rewards</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="user"></i>
              <span>Profile</span>
            </a>
            <a href="#" class="nav-item">
              <i data-lucide="settings"></i>
              <span>Admin</span>
            </a>
          </nav>
        </div>

        <div class="sidebar-bottom">
          <div class="slogan-card">
            <div class="globe-icon">
              <i data-lucide="globe"></i>
            </div>
            <h4>Small actions brighter tomorrows.</h4>
            <p>People. Progress. A Greener Tomorrow.</p>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT AREA -->
      <main class="main-content">
        
        <!-- TOP HEADER -->
        <header class="top-header">
          <div class="search-bar">
            <i data-lucide="search"></i>
            <input type="text" placeholder="Search for initiatives, rewards, or people...">
          </div>

          <div class="header-right">
            <button class="notification-btn" aria-label="Notifications">
              <i data-lucide="bell"></i>
              <span class="notification-badge"></span>
            </button>

            <div class="user-profile">
              <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=120" alt="Sarah Tan" class="avatar">
              <div class="user-info">
                <span class="user-name">Sarah Tan</span>
                <span class="user-role">Student</span>
              </div>
              <i data-lucide="chevron-down" class="dropdown-icon"></i>
            </div>
          </div>
        </header>

        <!-- DASHBOARD BODY -->
        <div class="dashboard-body">
          
          <!-- DASHBOARD HERO BANNER -->
          <section class="dash-banner">
            <div class="dash-banner-left">
              <span class="dash-tag"><i data-lucide="leaf"></i> DASHBOARD</span>
              <h1>Insights for a greener tomorrow.</h1>
              <p>Track progress, see how your community is doing, and find out who's making a real impact with EcoPoints.</p>
            </div>
            <div class="dash-filters">
              <div class="filter-dropdown">
                <i data-lucide="calendar"></i>
                <select>
                  <option>This Month</option>
                  <option>Last Month</option>
                </select>
                <i data-lucide="chevron-down"></i>
              </div>
              <div class="filter-dropdown">
                <i data-lucide="building-2"></i>
                <select>
                  <option>Campus</option>
                </select>
                <i data-lucide="chevron-down"></i>
              </div>
              <div class="filter-dropdown">
                <i data-lucide="map-pin"></i>
                <select>
                  <option>By Area</option>
                </select>
                <i data-lucide="chevron-down"></i>
              </div>
            </div>
          </section>

          <!-- TOP METRICS (4 CARDS ROW) -->
          <section class="stats-grid">
            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-green">
                  <i data-lucide="leaf"></i>
                </div>
              </div>
              <span class="stat-label">EcoPoints Earned<br><strong>This Month</strong></span>
              <div class="stat-value-group">
                <span class="stat-value">12,540</span>
                <span class="stat-pill pill-green"><i data-lucide="arrow-up-right"></i> +18%</span>
              </div>
              <p class="stat-subtext">vs. last month</p>
            </div>

            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-blue">
                  <i data-lucide="zap"></i>
                </div>
              </div>
              <span class="stat-label">Total Sustainability<br><strong>Activities</strong></span>
              <div class="stat-value-group">
                <span class="stat-value">356</span>
                <span class="stat-pill pill-green"><i data-lucide="arrow-up-right"></i> +24%</span>
              </div>
              <p class="stat-subtext">vs. last month</p>
            </div>

            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-orange">
                  <i data-lucide="bar-chart-2"></i>
                </div>
              </div>
              <span class="stat-label">Energy Usage<br><strong>(This Month)</strong></span>
              <div class="stat-value-group">
                <span class="stat-value">12,540 kWh</span>
                <span class="stat-pill pill-green"><i data-lucide="arrow-down-right"></i> 8%</span>
              </div>
              <p class="stat-subtext">vs. last month</p>
            </div>

            <div class="stat-card">
              <div class="stat-header">
                <div class="stat-icon icon-teal">
                  <i data-lucide="users"></i>
                </div>
              </div>
              <span class="stat-label">Participation Rate</span>
              <div class="stat-value-group">
                <span class="stat-value">68%</span>
                <span class="stat-pill pill-green"><i data-lucide="arrow-up-right"></i> +12%</span>
              </div>
              <p class="stat-subtext">of community members</p>
            </div>
          </section>

          <!-- CHARTS ROW (ENERGY USAGE TREND + SUSTAINABILITY PARTICIPATION) -->
          <section class="content-grid two-cols">
            
            <!-- LEFT CHART: ENERGY USAGE TREND -->
            <div class="card-box chart-card">
              <div class="card-title-bar">
                <div>
                  <div class="card-header-with-icon">
                    <i data-lucide="leaf" class="green-text-icon"></i>
                    <h3>Energy Usage Trend</h3>
                  </div>
                  <span class="card-sub-header">Total campus energy consumption</span>
                </div>
                <div class="mini-select">
                  <span>This Month</span>
                  <i data-lucide="chevron-down"></i>
                </div>
              </div>

              <!-- BAR + LINE CHART MOCKUP -->
              <div class="chart-container-large">
                <div class="chart-y-axis">
                  <span>20K</span>
                  <span>15K</span>
                  <span>10K</span>
                  <span>5K</span>
                  <span>0</span>
                </div>
                
                <div class="chart-area-wrap">
                  <div class="chart-tooltip-pin" style="left: 60%; top: 35%;">
                    <strong>8,200 kWh</strong>
                    <small>18 Jun 2024</small>
                  </div>

                  <!-- SVG TREND LINE OVERLAY -->
                  <svg class="trend-line-svg" viewBox="0 0 500 150" preserveAspectRatio="none">
                    <path d="M 10 30 Q 80 10, 150 40 T 300 70 T 490 60" fill="none" stroke="#059669" stroke-width="3"/>
                  </svg>

                  <div class="chart-bars-group">
                    <div class="chart-col"><div class="bar-fill-light" style="height: 70%;"></div></div>
                    <div class="chart-col"><div class="bar-fill-light" style="height: 75%;"></div></div>
                    <div class="chart-col"><div class="bar-fill-light" style="height: 65%;"></div></div>
                    <div class="chart-col"><div class="bar-fill-light" style="height: 55%;"></div></div>
                    <div class="chart-col"><div class="bar-fill-light" style="height: 50%;"></div></div>
                    <div class="chart-col"><div class="bar-fill-light" style="height: 48%;"></div></div>
                    <div class="chart-col"><div class="bar-fill-light" style="height: 52%;"></div></div>
                    <div class="chart-col"><div class="bar-fill-light" style="height: 50%;"></div></div>
